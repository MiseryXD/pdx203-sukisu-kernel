# 下次编译要带的环境变量（等 clang r563880c 就位后使用）
# 用法：
#   KSU_SRC_LOCAL=/home/<user>/src/vendor/src \
#   CONFIG_FILE=/home/<user>/ksu-build/config/pdx203_ksu_lto.config \
#   CLANG_VER=r563880c \
#   KSU_VERSION_FULL_OVERRIDE='SukiSUv4.3.0-r2' \
#   KSU_ALLOW_LTO=1 JOBS=24 bash tools/wsl_build.sh

CLANG_VER=r563880c
KSU_VERSION_FULL_OVERRIDE='SukiSUv4.3.0-r2'
KSU_SRC_LOCAL=/home/<user>/src/vendor/src
CONFIG_FILE=/home/<user>/ksu-build/config/pdx203_ksu_lto.config
KSU_ALLOW_LTO=1
JOBS=24

# 说明：
# - KSU_VERSION_FULL_OVERRIDE 由 build.sh 的 3m 步骤注入 kernel/Kbuild，
#   只改「内核完整版本」这行显示，不改 working version(41175)，管理器兼容性不受影响。
# - 驱动侧缓冲区 255 字节（uapi/supercall.h），当前串 16 字节，不会被截断。
